rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acceptance records are versioned, immutable and limited to the account owner.
    match /users/{userId}/legal/{acceptanceId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner()
        && acceptanceId in [
          'acceptance-2026-10-12-v1',
          'acceptance-2026-10-12-v2'
        ];
      allow list: if false;
      allow create: if isOwner()
        && acceptanceId == 'acceptance-2026-10-12-v2'
        && request.resource.data.keys().hasOnly([
          'termsVersion',
          'privacyVersion',
          'syncConsent',
          'projectSyncConsent',
          'acceptedAt'
        ])
        && request.resource.data.keys().hasAll([
          'termsVersion',
          'privacyVersion',
          'syncConsent',
          'projectSyncConsent',
          'acceptedAt'
        ])
        && request.resource.data.termsVersion == '2026-10-12-v2'
        && request.resource.data.privacyVersion == '2026-10-12-v2'
        && request.resource.data.syncConsent == true
        && request.resource.data.projectSyncConsent == true
        && request.resource.data.acceptedAt == request.time;
      allow update: if false;
      allow delete: if isOwner()
        && acceptanceId in [
          'acceptance-2026-10-12-v1',
          'acceptance-2026-10-12-v2'
        ];
    }

    // Each verified account owner with current consent can access their own profiles.
    match /users/{userId}/workshop/profiles {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isVerifiedOwner() {
        return isOwner() && request.auth.token.email_verified == true;
      }

      function hasCurrentAcceptance() {
        let acceptancePath = /databases/$(database)/documents/users/$(userId)/legal/acceptance-2026-10-12-v2;
        return exists(acceptancePath)
          && get(acceptancePath).data.termsVersion == '2026-10-12-v2'
          && get(acceptancePath).data.privacyVersion == '2026-10-12-v2'
          && get(acceptancePath).data.syncConsent == true
          && get(acceptancePath).data.projectSyncConsent == true;
      }

      allow get: if isVerifiedOwner() && hasCurrentAcceptance();
      allow list: if false;
      function hasFreshProEntitlement() {
        let entitlementPath = /databases/$(database)/documents/billingEntitlements/$(userId);
        return exists(entitlementPath)
          && get(entitlementPath).data.tier == 'pro'
          && get(entitlementPath).data.checkedUntil is timestamp
          && get(entitlementPath).data.checkedUntil > request.time
          && (get(entitlementPath).data.ownerAccess == true
            || (get(entitlementPath).data.validUntil is timestamp
              && get(entitlementPath).data.validUntil > request.time));
      }

      allow create, update: if isVerifiedOwner()
        && hasCurrentAcceptance()
        && hasFreshProEntitlement()
        && request.resource.data.keys().hasOnly([
          'materials',
          'printers',
          'deletedMaterials',
          'deletedPrinters',
          'schemaVersion',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'materials',
          'printers',
          'deletedMaterials',
          'deletedPrinters',
          'schemaVersion'
        ])
        && request.resource.data.materials is list
        && request.resource.data.printers is list
        && request.resource.data.deletedMaterials is list
        && request.resource.data.deletedPrinters is list
        && request.resource.data.materials.size() <= 1000
        && request.resource.data.printers.size() <= 100
        && request.resource.data.deletedMaterials.size() <= 10000
        && request.resource.data.deletedPrinters.size() <= 10000;
      // Owners may delete their profile even if email verification or policy acceptance is missing.
      allow delete: if isOwner();
    }

    // A project document contains saved calculator state and metadata, never the uploaded model-file blob.
    match /users/{userId}/projects/{projectId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isVerifiedOwner() {
        return isOwner() && request.auth.token.email_verified == true;
      }

      function hasCurrentAcceptance() {
        let acceptancePath = /databases/$(database)/documents/users/$(userId)/legal/acceptance-2026-10-12-v2;
        return exists(acceptancePath)
          && get(acceptancePath).data.termsVersion == '2026-10-12-v2'
          && get(acceptancePath).data.privacyVersion == '2026-10-12-v2'
          && get(acceptancePath).data.syncConsent == true
          && get(acceptancePath).data.projectSyncConsent == true;
      }

      function validProjectDocument() {
        return request.resource.data.keys().hasOnly([
            'schemaVersion',
            'updated',
            'deleted',
            'project'
          ])
          && request.resource.data.keys().hasAll([
            'schemaVersion',
            'updated',
            'deleted'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.updated is number
          && request.resource.data.deleted is bool
          && (request.resource.data.deleted
            ? !request.resource.data.keys().hasAny(['project'])
            : request.resource.data.keys().hasAll(['project'])
              && request.resource.data.project is map
              && request.resource.data.project.keys().hasOnly([
                'id',
                'name',
                'updated',
                'material',
                'hours',
                'used',
                'currency',
                'data',
                'file',
                'fileData',
                'fileStatus'
              ])
              && request.resource.data.project.keys().hasAll([
                'id',
                'name',
                'updated',
                'material',
                'hours',
                'used',
                'currency',
                'data',
                'file',
                'fileData',
                'fileStatus'
              ])
              && request.resource.data.project.id == projectId
              && request.resource.data.project.name is string
              && request.resource.data.project.updated is number
              && request.resource.data.project.data is map);
      }

      // Owners can retrieve their records for sync or account deletion.
      allow get, list: if isVerifiedOwner();
      function hasFreshProEntitlement() {
        let entitlementPath = /databases/$(database)/documents/billingEntitlements/$(userId);
        return exists(entitlementPath)
          && get(entitlementPath).data.tier == 'pro'
          && get(entitlementPath).data.checkedUntil is timestamp
          && get(entitlementPath).data.checkedUntil > request.time
          && (get(entitlementPath).data.ownerAccess == true
            || (get(entitlementPath).data.validUntil is timestamp
              && get(entitlementPath).data.validUntil > request.time));
      }

      allow create, update: if isVerifiedOwner()
        && hasCurrentAcceptance()
        && hasFreshProEntitlement()
        && validProjectDocument();
      // Owners can remove their project records when deleting an account.
      allow delete: if isOwner();
    }

    // Entitlements and owner-dashboard administration records are server-only.
    // Trusted Cloud Functions use the Admin SDK, which bypasses these client rules.
    match /billingEntitlements/{userId} {
      allow read, write: if false;
    }

    match /adminGrants/{userId} {
      allow read, write: if false;
    }

    match /adminAudit/{entryId} {
      allow read, write: if false;
    }

    // Deny access to all other documents unless another explicit rule is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
