# Public configuration only. Copy to .env.printprofit-test before test deployment.
# Keep checkout disabled until the test frontend and signed webhook are ready.
PRINTPROFIT_BILLING_ENABLED=false
STRIPE_PRO_MONTHLY_PRICE=price_1URJCAV054u1E901uBTn2U1J
STRIPE_PRO_ANNUAL_PRICE=price_1URcRuV054u1E901FcHEWMqw
