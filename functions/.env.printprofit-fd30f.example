# Public configuration only. Copy to .env.printprofit-fd30f in Cloud Shell before production deployment.
# Keep checkout disabled until the live webhook, rules, and end-to-end checks are ready.
PRINTPROFIT_BILLING_ENABLED=false
STRIPE_PRO_MONTHLY_PRICE=price_1URXC0V05QYif292e4PfFIMc
STRIPE_PRO_ANNUAL_PRICE=price_1URXCEV05QYif292TF3wmWyX
# Optional: a verified owner account receives Pro without a subscription.
# Put the actual email in the local .env.printprofit-fd30f file only.
PRINTPROFIT_OWNER_EMAIL=

# Private owner dashboard. Set the exact verified owner Firebase Auth UID.
PRINTPROFIT_ADMIN_UID=
# Numeric GA4 property ID, not the G- measurement ID. Optional until traffic is connected.
PRINTPROFIT_GA_PROPERTY_ID=
